# Only the public project files below belong in the repository.
/*
!/.gitignore
!/README.md
!/app.py
!/vision.py
!/config.json
!/requirements.txt
!/requirements-training.txt
!/export_onnx.py
!/train.py
!/convert.py
!/auto_label.py
!/screener.py
!/class.txt
!/data.yaml
!/runs/
!/assets/
/assets/*
!/assets/cyrillic_rec.onnx
!/assets/README.md
!/assets/LICENSE.txt

# Keep only the best training run and selected artifacts.
/runs/*
!/runs/detect/
/runs/detect/*
!/runs/detect/cookie_detector/
/runs/detect/cookie_detector/*
!/runs/detect/cookie_detector/weights/
!/runs/detect/cookie_detector/results.png
!/runs/detect/cookie_detector/results.csv
!/runs/detect/cookie_detector/args.yaml
/runs/detect/cookie_detector/weights/*
!/runs/detect/cookie_detector/weights/best.pt
!/runs/detect/cookie_detector/weights/best.onnx

# Never include virtual environments, datasets, caches or local captures.
**/__pycache__/
**/.venv*/
**/venv*/
**/.env
**/*.pyc
**/*.cache
**/images/
**/labels/
**/screenshots/
**/synthetic/
!/assets/cookie.png
